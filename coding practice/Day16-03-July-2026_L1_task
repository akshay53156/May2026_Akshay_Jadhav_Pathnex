# Kubernetes — StatefulSet

apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: pathnex-db
spec:
  serviceName: "Pathnex"
  replicas: 2
  selector:
    matchLables:
      app: pathnex-db
  template:
    metadata:
      labels: 
        app: pathnex-db
    spec:
      containers:
        - name: db
          image: mysql
          env:
            - name: MYSQL_ROOT_PASSWORD
              value: "Pathnex123"

