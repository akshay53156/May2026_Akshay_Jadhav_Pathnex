#Terraform : DynamoDB Table

resource "aws_dynamodb_table" "Pathnex-dynamodb" {
    name = "PathnexBillingTable"
    billing_mode = "PAY_PER_REQUEST"
    hash_key = "ID"

    attributes = {
        name = "ID"
        type = "S"
    }

    tags = {
        name = "Pathnex-DDT"
    }
}

