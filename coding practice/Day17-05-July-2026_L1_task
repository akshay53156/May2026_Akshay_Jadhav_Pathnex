#terraform create loadbalancer

resource "aws_lb" "PathnexALB" {
  name = "Pathnex-alb"
  load_balancer_type = "Application"
  subnet_id = [aws_subnet.PathnexSubnet.id]

  tags = {
    name = "Pathnex-alb"
  }
}

