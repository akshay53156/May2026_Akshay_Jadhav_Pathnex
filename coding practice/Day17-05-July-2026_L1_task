#Ansible — Create Multiple Users in Loop

---
- name: Ansible Create multiple users
  hosts: all
  become: yes

  vars:
    users:
      - dev1
      - dev2
      - dev3

  tasks:
    - name:create pathnex users
      user:
        name: "{{ item }}"
        state: present
      loop: "{{ users }}"

