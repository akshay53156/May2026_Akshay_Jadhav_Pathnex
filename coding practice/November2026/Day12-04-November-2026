#Ansible: setup autoScaling group
---
- name: Setup Autoscaling group
  host: all
  become: yes

  tasks:
    - name: Setup Autoscaling group
      ec2_asg:
        name: pathnex-asg
        region: us-east-1
        launch_config_name: pathnex-launch-config
        min_size: 1
        max_size: 3
        desired_capacity: 2
        vpc_zone_identifier: subnet-12345678

#Terraform: Create load Balancer
resource "aws_lb" "pathnex_lb" {
  name               = "pathnex-lb"
  internal           = false
  load_balancer_type = "application"
  security_group     = [aws_security_group.pathnex_asg.id]
  subnet             = [aws_subnet.public.id]
}

resource "aws_instance" "pathnex_ec2" {
  ami            = "i-abcd1234abncd1234"
  instance_type  = "t2.medium"
  security_group = [aws_security_group.pathnex_asg.name]

  tags = {
    Name = "Pathnex-EC2"
  }
}

#Kubernetes HPA(Horizontal Pod Autoscaler) with LoadBalancer
apiVersion: apps/v1
kind: Deployment
metadata:
  app: pathnex-deployment
spec:
  replicas: 2
  selector:
    matchLabels:
      app: pathnex-app
  template:
    metadata:
      labels:
        app: pathnex-app
    spec:
      containers:
        - name: nginx
          image: nginx
          ports:
            - containerPort: 80

---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  app: pathnex-hpa
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: pathnex-app
  minReplicas: 1
  maxReplicas: 5
  targetCPUUtilizationPercentage: 80

