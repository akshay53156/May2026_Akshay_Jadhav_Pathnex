# Docker integration with Jenkins and Gitlab

# Ansible: Setup Docker Container for Nginx

---
- name: Setup Docker Container with Nginx
  hosts: all
  become: yes

  tasks:
    - name: Setup Docker Container
      docker_image:
        image: nginx
        source: pull
    
    - name: Run Docker Container
      docker_container:
        name: nginx-container
        image: nginx
        state: started
        published_ports:
          - "8080:80"

# Terraform- Deploy EC2 with autoScaling

resource "aws_launch_configuration" "demo_lc" {
    name = "example_config"
    image_ami = "ami-abcd1234abcd1234"
    instance_type = "t3.medium"
}

resource "aws_autoscaling_group" "demo_ag" {
    desired_capacity = 2
    min_size = 1
    max_size = 5
    vpc_zone_identifier = ["subnet-12345"]
    launch_configuration = aws_launch_configuration.demo_lc.name
}

# Kubernetes - Horizontal Pod Autoscaler (HPA)

apiVersion: apps/v1
kind: Deployment
metadata:
  name: pathnex-deployment
spec:
  replicas: 3
  selector:
    matchLabels:
      app: pathnex-app
  template:
    metadata:
      labels:
        app: pathnex-app
  spec:
    containers:
      - name: nginx
        image: nginx
        ports:
          - containerPort: 80

---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: pathnex-hpa
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: pathnex-deployment
  minReplicas: 1
  maxReplicas: 10
  targetCPUUtilizationPercentage: 50

# Jenkinsfile deploy to kubernetes

pipeline {
    agent any
    stages {
        stage ('Deploy kubernetes manifest') {
            steps {
                script {
                    sh 'kubectl apply -f deployment.yaml'
                }

            }
        }
    }
}

# Docker - Environment Variables
FROM ubuntu:22.04
ENV INSTITUTE=Pathnex
ENV COURSE=Devops
CMD echo "$INSTITUTE - $COURSE"
