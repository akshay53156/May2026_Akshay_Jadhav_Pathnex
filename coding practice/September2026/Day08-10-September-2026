# Introduction to Docker and CI CD Pipelines

---
- name: Install docker-compose
  hosts: all
  become: yes

  tasks:
    - name: Install dependencies
      yum:
        name: "python3-pip"
        state: present
    
    - name: Install docker-compose
      pip:
        - name: docker-compose

# Terraform ec2 with security group and EBS volume

provider "aws" {
    region = "ap-south-1"
}

resource "aws_security_group" "demo_sg" {
    name = "allow ssh and 80 port"
    description = "allow SSH and HTTP access"

    ingress {
        from_port = 22
        to_port = 22
        protocol = "tcp"
        cidr_blocks = ["0.0.0.0/0"]
    }

    ingress {
        from_port = 80
        to_port = 80
        protocol = "tcp"
        cidr_blocks = ["0.0.0.0/0"]
    }

    egress {
        from_port = 0
        to_port = 0
        protocol = "-1"
        cidr_blocks = ["0.0.0.0/0"]
    }
}

resource "aws_instance" "demo_ec2" {
    ami = "ami-abcd1234abcd1234"
    instance_type = "c7i-flex.large"
    security_groups = [aws_security_group.demo_sg.name]

    ebs_block_device {
        device_name = '/dev/sdh'
        volume_size = 30
    }
}

# Jenkinsfile: docker build and Push

pipeline {
    agent any
    stages {
        stage ('docker build') {
            steps {
                sh 'docker build -t pathnex/pathnex-app:latest .'
            }
        }

        stage ('docker push') {
            steps {
                script {
                    docker.withRegistry ('https://docker.io', 'docker-credentials') {
                        docker.image('pathnex/pathnex-app').push('latest')
                    }
                }
            }
        }
    }
}

# Kubernetes: Service with nodeport

apiVersion: v1
kind: Service
metadata: 
  name: pathnex-service
spec:
  type: NodePort
  selector:
    app: pathnex-app
  ports:
    - protocol: TCP
      port: 80
      nodePort: 30007

# Alpine linux

FROM alpine:latest
WORKDIR /opt/pathnex/alpine-app
COPY . .
CMD ["echo", "Hello Pathnex"]